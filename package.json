{
  "name": "captionforge",
  "version": "0.2.0",
  "private": true,
  "description": "Fast, local-first subtitles for short-form video.",
  "author": {
    "name": "Isaiah Paparella",
    "email": "clixpapa@gmail.com"
  },
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-whisper.cjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist": "npm run build && node scripts/fetch-whisper.cjs && electron-builder",
    "dist:mac": "npm run build && node scripts/fetch-whisper.cjs darwin-arm64 && electron-builder --mac",
    "dist:win": "npm run build && node scripts/prepare-win.cjs && node scripts/fetch-whisper.cjs win32-x64 && electron-builder --win --x64 -c.electronDist=",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "fetch:whisper": "node scripts/fetch-whisper.cjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "subset-font": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.3",
    "electron": "43.2.0",
    "electron-builder": "26.0.12",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "studio.captionforge.app",
    "productName": "CaptionForge",
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "dist-renderer/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.video",
      "identity": null,
      "signIgnore": [
        "app\\.asar\\.unpacked/node_modules/ffmpeg-static/ffmpeg$",
        "app\\.asar\\.unpacked/node_modules/ffprobe-static/.*/ffprobe$"
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "files": [
        "!node_modules/ffmpeg-static/ffmpeg.exe*",
        "!node_modules/ffprobe-static/bin/{win32,linux}/**",
        "!node_modules/@img/sharp-win32-*/**"
      ],
      "extraResources": [
        {
          "from": "vendor/whisper/darwin-arm64",
          "to": "whisper",
          "filter": [
            "**/*",
            "!.version"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "!node_modules/ffmpeg-static/ffmpeg",
        "!node_modules/ffmpeg-static/ffmpeg.{README,LICENSE}",
        "!node_modules/ffprobe-static/bin/{darwin,linux}/**",
        "!node_modules/ffprobe-static/bin/win32/ia32/**",
        "!node_modules/@img/sharp-darwin-*/**",
        "!node_modules/@img/sharp-libvips-darwin-*/**"
      ],
      "extraResources": [
        {
          "from": "vendor/whisper/win32-x64",
          "to": "whisper",
          "filter": [
            "**/*",
            "!.version"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "copyright": "Copyright © 2026 Isaiah Paparella"
  }
}
